{
  "name": "@bfocus/monitor-node",
  "version": "0.1.0",
  "description": "Monitoramento de erros do bFocus para Node.js — erros não tratados viram demanda, agrupados por causa e ligados ao cliente afetado.",
  "license": "MIT",
  "author": "Berni Software",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/rm.mjs dist dist-test",
    "build": "node scripts/rm.mjs dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/cjs-package.mjs",
    "build:test": "node scripts/rm.mjs dist-test && tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test --test-concurrency=1 dist-test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bfocus",
    "monitoring",
    "error-tracking",
    "crash-reporting",
    "express",
    "fastify",
    "nextjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernisoftware/bfocus.git",
    "directory": "monitor/node"
  },
  "homepage": "https://bfocus.com.br",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "express": "^4.21.2",
    "fastify": "^5.2.1",
    "typescript": "~5.9.2"
  }
}
